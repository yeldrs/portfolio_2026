---
// src/components/ImageModal.astro
// The site's fullscreen image modal (close button, prev/next arrows, Escape and
// arrow keys). Mount it once per page. Open it with window.showImageModal(url) or
// window.showImageModal(url, list); `images` is the default list the arrows page
// through (used when no list is passed).
import ArrowButton from "./ArrowButton.astro";
import { useTranslations } from "../i18n/utils";

export interface Props {
  images?: string[];
}

const { images = [] } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const arrowVariant = "tertiary";
---

<div
  id="imageModal"
  class="fixed inset-0 z-[9999] bg-black/80 hidden items-center justify-center p-4 cursor-zoom-out"
  aria-modal="true"
  role="dialog"
  onclick="window.hideImageModal()"
>
  {/* Close button */}
  <button
    id="closeModalBtn"
    class="absolute top-4 right-4 text-white text-3xl z-10 p-2 leading-none hover:text-red-400"
    aria-label={t("modal.close")}
    onclick="event.stopPropagation(); window.hideImageModal();"
  >
    &times;
  </button>

  <div
    class="relative flex items-center justify-center w-full h-full"
    onclick="event.stopPropagation()"
  >
    <ArrowButton
      id="modalPrevBtn"
      label={t("modal.previous")}
      direction="left"
      variant={arrowVariant as any}
      onClick="window.navigateModal(-1)"
      class="absolute left-0 z-10 transition-opacity disabled:opacity-30 disabled:pointer-events-none"
    />

    <img
      id="modalImage"
      data-current-modal-index="0"
      alt={t("modal.enlargedImageAlt")}
      class="max-w-full max-h-full object-contain"
    />

    <ArrowButton
      id="modalNextBtn"
      label={t("modal.next")}
      direction="right"
      variant={arrowVariant as any}
      onClick="window.navigateModal(1)"
      class="absolute right-0 z-10 transition-opacity disabled:opacity-30 disabled:pointer-events-none"
    />
  </div>
</div>

<script define:vars={{ defaultImages: images }} is:inline>
  // The modal pages through `modalImages`: by default the images given to the component
  // (the carousel on case-study pages), or the list passed to showImageModal(url, list).
  // An image outside the list opens on its own: index -1, no arrows, keyboard nav is a no-op.
  let modalImages = Array.isArray(defaultImages) ? defaultImages : [];

  window.isModalOpen = false;
  window.isInitialized = false;

  window.navigateModal = function (direction) {
    const modalImg = document.getElementById("modalImage");
    if (!modalImg || !window.isModalOpen) return;

    const currentIndex = parseInt(modalImg.dataset.currentModalIndex);
    if (isNaN(currentIndex) || currentIndex < 0) return; // not a carousel image

    const newIndex = currentIndex + direction;
    if (newIndex < 0 || newIndex >= modalImages.length) return;

    modalImg.src = modalImages[newIndex];
    modalImg.dataset.currentModalIndex = String(newIndex);
    updateModalArrows(newIndex);
  };

  window.showImageModal = function (imageUrl, list) {
    const modal = document.getElementById("imageModal");
    const modalImg = document.getElementById("modalImage");
    if (!modal || !modalImg || !imageUrl) return;

    if (window.isModalOpen) window.hideImageModal();

    modalImages = Array.isArray(list) ? list : Array.isArray(defaultImages) ? defaultImages : [];

    const index = modalImages.indexOf(imageUrl); // -1 for a standalone image
    modalImg.src = imageUrl;
    modalImg.dataset.currentModalIndex = String(index);

    modal.classList.remove("hidden");
    modal.classList.add("flex");
    window.isModalOpen = true;

    updateModalArrows(index);
    modal.focus();
  };

  window.hideImageModal = function () {
    const modal = document.getElementById("imageModal");
    if (modal && window.isModalOpen) {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      window.isModalOpen = false;
    }
  };

  // index === -1 (standalone image) or a carousel of 0/1 → no arrows at all.
  function updateModalArrows(index) {
    const prevBtn = document.getElementById("modalPrevBtn");
    const nextBtn = document.getElementById("modalNextBtn");
    if (!prevBtn || !nextBtn) return;

    const navigable = index >= 0 && modalImages.length > 1;
    prevBtn.classList.toggle("hidden", !navigable);
    nextBtn.classList.toggle("hidden", !navigable);

    prevBtn.disabled = !navigable || index <= 0;
    nextBtn.disabled = !navigable || index >= modalImages.length - 1;
  }

  function attachKeyboardHandler() {
    if (window.isInitialized) return;

    document.addEventListener("keydown", (event) => {
      if (window.isModalOpen) {
        if (event.key === "Escape") {
          window.hideImageModal();
        } else if (event.key === "ArrowLeft") {
          window.navigateModal(-1);
        } else if (event.key === "ArrowRight") {
          window.navigateModal(1);
        }
      }
    });
    window.isInitialized = true;
  }

  // --- Initialization ---
  // We use DOMContentLoaded to ensure the elements are in the DOM before attaching the handler
  document.addEventListener("DOMContentLoaded", () => {
    attachKeyboardHandler();
  });
  // We also attach on swap for Astro View Transitions
  document.addEventListener("astro:after-swap", attachKeyboardHandler);
</script>
