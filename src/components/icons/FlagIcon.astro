      <defs>
        <clipPath id={clipId}>
          <path d="M20 351C20 168.194 168.194 20 351 20V20C533.806 20 682 168.194 682 351V351C682 533.806 533.806 682 351 682V682C168.194 682 20 533.806 20 351V351Z" />
