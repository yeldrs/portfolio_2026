---
// src/components/icons/FlagIcon.astro
// Circular flag icons, extracted from the Figma component (2 variants: EN/GB, FR).
// Each flag's artwork is a full rectangle clipped to a circle — the clipPath is what
// gives the round shape, a viewBox crop alone would just show a square.
import { randomUUID } from "node:crypto";

export interface Props {
  lang: "en" | "fr";
  class?: string;
}

const { lang, class: className = "" } = Astro.props;
const clipId = `flag-clip-${randomUUID()}`;
---

{
  lang === "fr" ? (
    <svg width="20" height="20" viewBox="1368 20 662 662" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class={className}>
      <g clip-path={`url(#${clipId})`}>
        <path d="M1368 351C1368 168.194 1516.19 20 1699 20V20C1881.81 20 2030 168.194 2030 351V351C2030 533.806 1881.81 682 1699 682V682C1516.19 682 1368 533.806 1368 351V351Z" fill="white" />
        <path d="M2157 580.154C2157 607.165 2146.28 633.07 2127.19 652.17C2108.1 671.27 2082.22 682 2055.22 682H1851.67V20H2055.22C2082.22 20 2108.1 30.7302 2127.19 49.83C2146.28 68.9299 2157 94.8349 2157 121.846V580.154Z" fill="#ED2939" />
        <path d="M1342.78 20C1315.78 20 1289.9 30.7302 1270.81 49.83C1251.72 68.9299 1241 94.8349 1241 121.846V580.154C1241 607.165 1251.72 633.07 1270.81 652.17C1289.9 671.27 1315.78 682 1342.78 682H1546.33V20H1342.78Z" fill="#002495" />
        <path d="M1546.33 20H1851.67V682H1546.33V20Z" fill="#EEEEEE" />
      </g>
      <defs>
        <clipPath id={clipId}>
          <path d="M1368 351C1368 168.194 1516.19 20 1699 20V20C1881.81 20 2030 168.194 2030 351V351C2030 533.806 1881.81 682 1699 682V682C1516.19 682 1368 533.806 1368 351V351Z" />
        </clipPath>
      </defs>
    </svg>
  ) : (
    <svg width="20" height="20" viewBox="20 20 662 662" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class={className}>
      <g clip-path={`url(#${clipId})`}>
        <path d="M20 351C20 168.194 168.194 20 351 20V20C533.806 20 682 168.194 682 351V351C682 533.806 533.806 682 351 682V682C168.194 682 20 533.806 20 351V351Z" fill="white" />
        <path d="M-107 123.456V223.78H36.2013L-107 123.456ZM11.6729 682H223.778V533.41L11.6729 682ZM478.222 533.435V682H690.302L478.222 533.435ZM-107 478.347V578.671L36.2522 478.347H-107ZM690.353 20.1273H478.222V168.718L690.353 20.1273ZM809 578.697V478.347H665.722L809 578.697ZM809 223.78V123.456L665.773 223.78H809ZM223.778 20.1273H11.6729L223.778 168.718V20.1273Z" fill="#00247D" />
        <path d="M532.673 478.347L779.79 651.478C791.858 639.039 800.531 623.708 804.98 606.954L621.398 478.347H532.673ZM223.778 478.347H169.301L-77.7899 651.452C-64.5334 664.944 -47.5365 674.592 -28.4786 679.073L223.778 502.353V478.347ZM478.222 223.781H532.699L779.79 50.6753C766.305 36.9867 749.214 27.4086 730.504 23.0549L478.222 199.775V223.781ZM169.301 223.781L-77.7899 50.6753C-89.8518 63.123 -98.5319 78.4497 -103.005 95.199L80.5763 223.781H169.301Z" fill="#CF1B2B" />
        <path d="M809 427.306H427.333V681.873H478.222V533.308L690.302 681.873H707.222C720.74 681.875 734.122 679.176 746.583 673.935C759.045 668.693 770.334 661.015 779.79 651.35L532.673 478.22H621.398L804.98 606.827C807.346 598.248 809 589.363 809 580.046V578.57L665.722 478.22H809V427.306ZM-107 427.306V478.22H36.2522L-107 578.544V580.046C-107 607.819 -95.8299 632.945 -77.7898 651.325L169.301 478.22H223.778V502.225L-28.4785 678.92C-20.9978 680.702 -13.2627 681.873 -5.22223 681.873H11.6729L223.778 533.282V681.873H274.667V427.306H-107ZM809 121.827C809.015 95.1476 798.52 69.5374 779.79 50.548L532.699 223.653H478.222V199.648L730.504 22.9275C722.882 21.0571 715.07 20.0748 707.222 20H690.353L478.222 168.59V20H427.333V274.566H809V223.653H665.773L809 123.329V121.827ZM223.778 20V168.59L11.6729 20H-5.22223C-18.7428 19.9941 -32.1281 22.6937 -44.5904 27.9398C-57.0528 33.186 -68.3406 40.8728 -77.7898 50.548L169.301 223.653H80.5764L-103.005 95.0717C-105.53 103.77 -106.873 112.769 -107 121.827V123.329L36.2013 223.653H-107V274.566H274.667V20H223.778Z" fill="#EEEEEE" />
