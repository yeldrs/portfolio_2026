---
import DeviceFrame from "../DeviceFrame.astro";
import type { ImageMetadata } from "astro";

export interface Props {
  device?: "phone" | "tablet" | "desktop";
  platform?: "android" | "apple";
  theme?: "light" | "dark";
  landscape?: boolean;
  browser?: boolean;
  /** Without an image, the frame shows a neutral skeleton (screenshot still to come). */
  image?: ImageMetadata;
  alt?: string;
  sizes?: string;
  class?: string;
}

const { image, alt, ...frame } = Astro.props;
---

{/* File: src/components/workflow/WorkflowFrame.astro */}
{
  image ? (
    <DeviceFrame {...frame} src={image} alt={alt ?? ""} />
  ) : (
    <DeviceFrame {...frame}>
      <span aria-hidden="true" class="flex h-full flex-col gap-sm p-md">
        <span class="block h-md w-full rounded-md bg-gray-200" />
        <span class="block h-sm w-3/5 rounded-md bg-gray-200" />
        <span class="block w-full flex-1 rounded-md bg-gray-200" />
      </span>
    </DeviceFrame>
  )
}
