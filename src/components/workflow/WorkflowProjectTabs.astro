---
import { Image } from "astro:assets";
import ToolLogo from "./ToolLogo.astro";
import { PROJECT_ORDER } from "../../data/workflow.loader";
import { workflowImage } from "../../data/workflow.images";
import { useTranslations } from "../../i18n/utils";

export interface Props {
  lang: "en" | "fr";
  intros: Record<string, string>;
}

const { lang, intros } = Astro.props;
const t = useTranslations(lang);

// Rendered inside the tall `role="radiogroup"` column of WorkflowLayout, so the sticky bar
// can follow the whole list of steps (a sticky element only sticks inside its parent).
// One native radio group for the whole page: arrow keys work, no JS. The ancestor with
// `group/tabs` (WorkflowLayout) lets every step react to the selected radio through :has().
// The folder-tab look (rounded top, accent bar when selected) lives in the
// <style> below, built from theme() so every value still comes from tokens.js.
const introOn = [
  "group-has-[.r0:checked]/tabs:block",
  "group-has-[.r1:checked]/tabs:block",
  "group-has-[.r2:checked]/tabs:block",
];
const bannerOn = [
  "group-has-[.r0:checked]/tabs:flex",
  "group-has-[.r1:checked]/tabs:flex",
  "group-has-[.r2:checked]/tabs:flex",
];
---

{/* File: src/components/workflow/WorkflowProjectTabs.astro */}
<>
  {
    PROJECT_ORDER.map((id, i) => (
      <input type="radio" class={`sr-only r${i}`} name="workflow-project" id={`t-${id}`} checked={i === 0} />
    ))
  }
  <div class="sticky top-[calc(var(--site-nav-h,theme(spacing.3xl))+var(--step-menu-h,0px))] z-[1] grid grid-cols-3 gap-xs bg-background-page pt-sm before:absolute before:bottom-full before:left-1/2 before:h-md before:w-screen before:-translate-x-1/2 md:before:left-0 md:before:w-full md:before:translate-x-0 before:bg-background-page before:content-[''] after:pointer-events-none after:absolute after:left-1/2 after:top-[calc(100%+theme(spacing.xxs))] after:h-md after:w-screen after:-translate-x-1/2 md:after:left-0 md:after:w-full md:after:translate-x-0 after:bg-gradient-to-b after:from-background-page after:to-transparent after:content-['']">
    {/* Divider under the tabs: viewport-wide on mobile (the column is centred there), column-wide from md. */}
    <span aria-hidden="true" class="pointer-events-none absolute left-1/2 top-full h-0 w-screen -translate-x-1/2 border-b-2 md:left-0 md:w-full md:translate-x-0 border-stroke-neutral-primary" />
    {
      PROJECT_ORDER.map((id, i) => (
        <label
          for={`t-${id}`}
          data-tab={i}
          class="wf-tab box-border flex min-h-3xl cursor-pointer flex-col items-center justify-center gap-xs p-sm text-center text-sm font-bold md:flex-row md:gap-sm"
        >
          <ToolLogo id={id} variant="box" fill bordered={id !== "portfolio"} />
          <span>{t(`workflow.project.${id}`)}</span>
        </label>
      ))
    }
  </div>
  {/* One banner per project, under the tabs, so a tab change is visible at a glance. Drop
      src/assets/workflow/banner-<project-id>.webp (1800 x 600, subject inside the middle
      two thirds: mobile crops to 2:1) to replace the placeholder. */}
  <div class="mb-xl mt-lg">
    {
      PROJECT_ORDER.map((id, i) => {
        const banner = workflowImage(`banner-${id}.webp`);
        const name = t(`workflow.project.${id}`);
        return banner ? (
          <div class={`hidden aspect-[2/1] overflow-hidden rounded-card md:aspect-[3/1] ${bannerOn[i]}`}>
            <Image src={banner} alt={t("workflow.bannerAlt", { project: name })} widths={[640, 1280, 1800]} sizes="(min-width: 1200px) 880px, 100vw" format="webp" class="h-full w-full object-cover" />
          </div>
        ) : (
          <div
            role="img"
            aria-label={t("workflow.bannerAria", { project: name })}
            class={`relative hidden aspect-[2/1] items-center justify-center overflow-hidden rounded-card border border-dashed border-gray-500 bg-gray-100 md:aspect-[3/1] before:pointer-events-none before:absolute before:inset-y-0 before:left-[16.666%] before:right-[16.666%] before:border-x before:border-dashed before:border-gray-400 before:content-[''] ${bannerOn[i]}`}
          >
            <span aria-hidden="true" class="relative flex flex-col items-center gap-xs text-text-body-secondary">
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-lg w-lg text-gray-500">
                <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
              </svg>
              <b class="text-sm font-bold text-text-body-primary">{name}</b>
            </span>
          </div>
        );
      })
    }
  </div>
  <div>
    {
      PROJECT_ORDER.map((id, i) => (
        <p class={`m-0 hidden max-w-prose text-sm leading-relaxed text-text-body-secondary ${introOn[i]}`}>{intros[id]}</p>
      ))
    }
  </div>
</>

<style is:global>
  .wf-tab {
    position: relative;
    border: 1px solid theme("colors.gray.300");
    border-bottom-color: transparent;
    border-radius: theme("borderRadius.xl") theme("borderRadius.xl") 0 0;
    background: theme("colors.gray.100");
    color: theme("colors.text-body-secondary");
  }
  .wf-tab:hover {
    border-color: theme("colors.stroke-primary");
    border-bottom-color: transparent;
    background: theme("colors.background-primary");
    color: theme("colors.text-body-accent");
    box-shadow: inset 0 theme("spacing.xxs") 0 theme("colors.stroke-primary");
  }

  /* Selected tab: page background and accent bar on top; the divider under the bar stays unbroken */
  :is(
      [role="radiogroup"]:has(.r0:checked) .wf-tab[data-tab="0"],
      [role="radiogroup"]:has(.r1:checked) .wf-tab[data-tab="1"],
      [role="radiogroup"]:has(.r2:checked) .wf-tab[data-tab="2"]
    ) {
    border-color: theme("colors.gray.300");
    border-bottom-color: theme("colors.background-page");
    background: theme("colors.background-page");
    color: theme("colors.text-body-accent");
    box-shadow: inset 0 theme("spacing.xs") 0 theme("colors.stroke-primary");
  }

  /* Keyboard focus follows the radio */
  :is(
      [role="radiogroup"]:has(.r0:focus-visible) .wf-tab[data-tab="0"],
      [role="radiogroup"]:has(.r1:focus-visible) .wf-tab[data-tab="1"],
      [role="radiogroup"]:has(.r2:focus-visible) .wf-tab[data-tab="2"]
    ) {
    outline: theme("spacing.xxs") solid theme("colors.text-body-accent");
    outline-offset: calc(-1 * theme("spacing.xxs"));
  }
</style>
