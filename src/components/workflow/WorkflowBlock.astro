---
import type { CollectionEntry } from "astro:content";
import ToolLogo from "./ToolLogo.astro";
import WorkflowDiagram from "./WorkflowDiagram.astro";
import WorkflowGallery from "./WorkflowGallery.astro";
import WorkflowFigure from "./WorkflowFigure.astro";
import WorkflowScreen from "./WorkflowScreen.astro";
import { useTranslations } from "../../i18n/utils";

type Block = CollectionEntry<"workflow">["data"]["en"]["blocks"][number];

export interface Props {
  lang: "en" | "fr";
  block: Block;
  /** Anchor id, used by the in-panel index of a project with two sub-blocks. */
  id: string;
  /** Show the sub-block heading (steps 3 and 5). */
  showHeading: boolean;
}

const { lang, block, id, showHeading } = Astro.props;
const t = useTranslations(lang);

const dt = "m-0 mb-sm text-sm font-bold text-text-body-secondary";
const body = "text-base leading-relaxed text-text-body-primary";
---

{/* File: src/components/workflow/WorkflowBlock.astro */}
<div id={id} class="flex flex-col gap-md scroll-mt-[calc(var(--wf-sticky)+theme(spacing.sm))]">
  {
    showHeading && block.heading && (
      <div class="flex flex-wrap items-center gap-x-sm-d gap-y-xs">
        {block.subsection ? (
          <h4 class="m-0 text-lg font-semibold text-text-body-secondary">{block.heading}</h4>
        ) : (
          <h3 class="m-0 font-serif text-2xl font-semibold">{block.heading}</h3>
        )}
      </div>
    )
  }
  {
    block.status === "not-applicable" ? (
      <p class="m-0 text-base text-text-body-secondary">{t("workflow.notApplicableStep")}</p>
    ) : (
      <>
        {block.toolsFirst && !block.diagram && block.tools.length > 0 && (
          <div class="max-w-prose">
            {/* Vertical rule on the left edge of each tool; the wrapper clips the one at the start of a row. */}
            <div class="overflow-hidden">
            <ul class="-ml-lg my-0 mr-0 flex list-none flex-wrap gap-y-md p-0">
              {block.tools.map((tool) => (
                <li class="relative flex flex-auto items-center gap-sm px-lg before:absolute before:left-0 before:top-1/2 before:h-md before:-translate-y-1/2 before:border-l before:border-stroke-neutral-primary before:content-[''] text-sm text-text-body-primary">
                  <ToolLogo id={tool.id} variant="bare" size="lg" />
                  <span>
                    {tool.label}
                    {tool.note && (
                      <span class="block text-xs font-normal text-text-body-secondary">{tool.note}</span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
            </div>
          </div>
        )}
        {/* Reading order: the explanatory text first, then the screens and figures, the diagram, link, tools
            and the correction last. */}
        {/* Text follows the step's text column (max-w-prose, same as the generic step copy);
            only screens and diagrams use the full panel width.  */}
        {block.points.length > 0 && (
          <ul class="m-0 flex max-w-prose list-none flex-col gap-sm p-0">
            {block.points.map((point) => (
              <li class={body}>{point}</li>
            ))}
          </ul>
        )}
        {block.media.map((group, k) => (
          <>
            {group.screens.length > 0 && (
              /* Screens use the full viewport width on mobile: the container gutter goes,
                 the labels stay aligned with the rest of the copy. */
              <div class="-mx-md md:mx-0">
                {group.gallery === "grid" ? (
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-lg items-start">
                    {group.screens.map((screen, i) => (
                      <WorkflowScreen
                        lang={lang}
                        index={i + 1}
                        caption={screen.caption}
                        src={screen.src}
                        alt={screen.alt}
                        callouts={screen.callouts}
                        group={`${id}-m${k}`}
                      />
                    ))}
                  </div>
                ) : (
                  <WorkflowGallery lang={lang} gallery={group.gallery} screens={group.screens} group={`${id}-m${k}`} startAt={group.startAt} />
                )}
              </div>
            )}
            {/* A design artifact (Figma panel, token export) sits under the screens, flat and at
                its own ratio: no device frame, the content is not a screen of the product. */}
            {group.figure && <WorkflowFigure lang={lang} figure={group.figure} group={`${id}-m${k}`} />}
          </>
        ))}
        {block.diagram && <WorkflowDiagram lang={lang} diagram={block.diagram} id={`dg-${id}`} />}
        {block.link && (
          <p class="m-0 max-w-prose text-base">
            <a href={block.link} target="_blank" rel="noopener noreferrer" class="link font-semibold">
              {block.linkLabel ?? block.link}
            </a>
          </p>
        )}
        {block.callToAction && <p class="m-0 max-w-prose text-base font-semibold text-text-body-accent">{block.callToAction}</p>}
        {!block.toolsFirst && !block.diagram && block.tools.length > 0 && (
          <div class="max-w-prose">
            <p class={dt}>{t("workflow.tools")}</p>
            {/* Vertical rule on the left edge of each tool; the wrapper clips the one at the start of a row. */}
            <div class="overflow-hidden">
            <ul class="-ml-lg my-0 mr-0 flex list-none flex-wrap gap-y-md p-0">
              {block.tools.map((tool) => (
                <li class="relative flex flex-auto items-center gap-sm px-lg before:absolute before:left-0 before:top-1/2 before:h-md before:-translate-y-1/2 before:border-l before:border-stroke-neutral-primary before:content-[''] text-sm text-text-body-primary">
                  <ToolLogo id={tool.id} variant="bare" size="lg" />
                  <span>
                    {tool.label}
                    {tool.note && (
                      <span class="block text-xs font-normal text-text-body-secondary">{tool.note}</span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
            </div>
          </div>
        )}
        {/* The correction closes the block, after the screens and the tools. */}
        {block.correction && (
          <div class="max-w-prose rounded-md border border-stroke-secondary p-md">
            <p class={dt}>{t("workflow.correction")}</p>
            <p class="m-0 text-sm leading-relaxed text-text-body-primary">{block.correction}</p>
          </div>
        )}
      </>
    )
  }
</div>
