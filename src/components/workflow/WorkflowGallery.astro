---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import WorkflowFrame from "./WorkflowFrame.astro";
import { workflowImage, zoomUrl } from "../../data/workflow.images";
import { useTranslations } from "../../i18n/utils";

type Block = CollectionEntry<"workflow">["data"]["en"]["blocks"][number];
type Screen = Block["media"][number]["screens"][number];

export interface Props {
  lang: "en" | "fr";
  gallery: "pairs" | "rail" | "spotlight";
  screens: Screen[];
  /** Screens sharing a group id page through each other in the preview modal. */
  group: string;
  /** Spotlight: 1-based screen shown on arrival. */
  startAt?: number;
  /** Maps a `src` name to its image. Defaults to the workflow assets; case studies pass their own. */
  resolve?: typeof workflowImage;
}

const { lang, gallery, screens, group, startAt = 1, resolve = workflowImage } = Astro.props;
const start = Math.min(Math.max(startAt, 1), screens.length) - 1;
const t = useTranslations(lang);

// Real device sizes (dp / pt). The rail draws every frame at the same px/dp scale. The
// spotlight gives every frame the same height instead, so the row reads as one layout at
// different widths: the frame ratio matches the dp ratio for each device type below.
function size(s: Screen) {
  if (s.flat) return { w: 1280, h: 720 };
  if (s.device === "tablet") return s.landscape ? { w: 1280, h: 800 } : { w: 800, h: 1280 };
  if (s.device === "desktop") return { w: 1280, h: 800 };
  return { w: 360, h: 800 };
}

const items = await Promise.all(
  screens.map(async (s, i) => {
    const image = resolve(s.src);
    const before = resolve(s.before?.src);
    const dp = size(s);
    return {
      ...s,
      n: i + 1,
      image,
      before,
      zoom: image && s.alt ? await zoomUrl(image) : undefined,
      partImages: (s.parts ?? []).map((name) => resolve(name)).filter((p): p is NonNullable<typeof p> => Boolean(p)),
      beforeAlt: s.before?.alt,
      beforeZoom: before ? await zoomUrl(before) : undefined,
      dp,
      ar: dp.w / dp.h,
    };
  }),
);
type Item = (typeof items)[number];

// Width factor of a frame in the spotlight row (desktop = reference, tablet and phone step down).
const widthFactor = (s: Item) => (s.flat || s.device === "desktop" ? 1 : s.device === "tablet" ? 0.9 : 0.8);

const frame = (s: Item) => ({
  device: s.device,
  platform: s.platform,
  theme: s.theme,
  landscape: s.landscape,
  browser: s.browser,
  scroll: s.scroll,
  parts: s.partImages.length > 0 ? s.partImages.map((image, i) => ({ image, sticky: i === s.sticky })) : undefined,
});
const zoomBtn =
  "block w-full cursor-zoom-in border-0 bg-transparent p-0 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-body-accent";
const arrowBtn =
  "absolute top-1/2 z-[3] flex h-xl w-xl -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-gray-300 bg-background-primary p-0 text-text-body-accent shadow-sm disabled:cursor-default disabled:opacity-30 md:h-2xl md:w-2xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-body-accent";
---

{/* File: src/components/workflow/WorkflowGallery.astro */}

{
  gallery === "pairs" && (
    <div class="grid grid-cols-1 gap-x-xl gap-y-2xl sm:grid-cols-2">
      {items.map((s) => (
        <figure class="m-0 flex flex-col gap-sm">
          <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-x-sm gap-y-xs">
            <p class="m-0 text-xs font-bold text-text-body-secondary">{t("workflow.wireframe")}</p>
            <span aria-hidden="true" />
            <p class="m-0 text-xs font-bold text-text-body-secondary">{t("workflow.finalScreen")}</p>

            {s.beforeZoom ? (
              <button type="button" data-zoom={s.beforeZoom} data-zoom-group={group} aria-label={t("workflow.zoomAria", { caption: `${t("workflow.wireframe")}, ${s.caption}` })} class={zoomBtn}>
                <WorkflowFrame {...frame(s)} image={s.before} alt={s.beforeAlt} sizes="(min-width: 640px) 200px, 40vw" class="w-full" />
              </button>
            ) : (
              <WorkflowFrame {...frame(s)} class="w-full" />
            )}

            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="h-lg w-lg flex-none text-gray-500">
              <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" />
            </svg>

            {s.zoom ? (
              <button type="button" data-zoom={s.zoom} data-zoom-group={group} aria-label={t("workflow.zoomAria", { caption: s.caption })} class={zoomBtn}>
                <WorkflowFrame {...frame(s)} image={s.image} alt={s.alt} sizes="(min-width: 640px) 200px, 40vw" class="w-full" />
              </button>
            ) : (
              <WorkflowFrame {...frame(s)} class="w-full" />
            )}
          </div>
          <figcaption class="flex flex-col gap-xs text-sm text-text-body-primary">
            <b class="font-bold">{s.caption}</b>
            {s.sub && <span class="text-xs text-text-body-secondary">{s.sub}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  )
}

{
  gallery === "rail" && (
    <div class="wg-rail relative" role="group" aria-label={t("workflow.galleryAria")}>
      {/* Cutting-mat grid: design-phase backdrop, fades out on every side. */}
      <span aria-hidden="true" class="wg-mat" />
      <div class="wg-rail-track">
        {items.map((s) => {
          const Tag = s.zoom ? "button" : "div";
          return (
            <Tag
              class:list={["wg-ritem relative flex flex-none flex-col gap-sm border-0 bg-transparent p-0 text-left", s.zoom && "cursor-zoom-in focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-body-accent"]}
              style={`--ar:${s.ar}`}
              data-device={s.device}
              {...(s.zoom ? { type: "button", "data-zoom": s.zoom, "data-zoom-group": group, "aria-label": t("workflow.zoomAria", { caption: s.caption }) } : {})}
            >
              {/* Wireframes are flat screens: no device frame, just the screen itself. */}
              <span class="wg-flat block overflow-hidden rounded-md border border-gray-300 bg-gray-100" style={`aspect-ratio:${s.dp.w}/${s.dp.h}`}>
                {s.image ? (
                  <Image src={s.image} alt={s.alt ?? ""} widths={[240, 480, 960]} sizes="(min-width: 768px) 420px, 60vw" format="webp" loading="lazy" decoding="async" class="block h-full w-full object-cover object-top" />
                ) : (
                  <span aria-hidden="true" class="flex h-full flex-col gap-sm p-md">
                    <span class="block h-md w-full rounded-md bg-gray-200" />
                    <span class="block h-sm w-3/5 rounded-md bg-gray-200" />
                    <span class="block w-full flex-1 rounded-md bg-gray-200" />
                  </span>
                )}
              </span>
              <span class="absolute inset-x-0 top-full mt-sm block text-center text-xs text-text-body-secondary">
                <span class="whitespace-nowrap">{s.caption}</span>
              </span>
            </Tag>
          );
        })}
      </div>
    </div>
  )
}

{
  gallery === "spotlight" && (
    <div
      data-spot
      data-start={start}
      data-count-template={t("workflow.galleryCount", { n: "{n}", total: String(items.length) })}
      role="group"
      aria-label={t("workflow.galleryAria")}
      data-ext={items.some((s) => s.scroll) ? "" : undefined}
      data-mat={items.every((s) => s.flat) ? "grid" : undefined}
      style={`--last-ar:${items[items.length - 1].ar};--last-k:${widthFactor(items[items.length - 1])}`}
      class="wg-spot relative"
    >
      {/* Measuring canvas: a large dot field that starts before the screens and fades out. */}
      <span aria-hidden="true" class="wg-spot-mat" />
      <div data-spot-track class="wg-track">
        {items.map((s, i) => {
          // A long capture scrolls inside its frame: a <div role="button"> keeps the wheel and
          // touch scrolling working where a <button> would not.
          const Tag = s.zoom && !s.scroll ? "button" : "div";
          return (
            <Tag
              class:list={["wg-item flex-none border-0 bg-transparent p-0 text-left", s.zoom && "cursor-zoom-in focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-body-accent"]}
              style={`--ar:${s.ar}`}
              data-on={String(i === start)}
              data-caption={s.caption}
              data-device={s.device}
              data-has-zoom={String(Boolean(s.zoom))}
              {...(s.zoom ? { ...(s.scroll ? { role: "button", tabindex: 0 } : { type: "button" }), "data-zoom": s.zoom, "data-zoom-group": group, "aria-label": t("workflow.zoomAria", { caption: s.caption }) } : {})}
            >
              {s.flat && s.image ? (
                <span class="wg-flat block overflow-hidden rounded-md" style={`aspect-ratio:${s.dp.w}/${s.dp.h}`}>
                  <Image src={s.image} alt={s.alt ?? ""} widths={[480, 960, 1280]} sizes="(min-width: 768px) 720px, 80vw" format="webp" loading="lazy" decoding="async" class="block h-full w-full object-cover" />
                </span>
              ) : (
                <WorkflowFrame {...frame(s)} image={s.image} alt={s.alt} sizes={s.device === "desktop" || s.landscape ? "(min-width: 768px) 640px, 80vw" : "(min-width: 768px) 320px, 50vw"} class="w-full" />
              )}
              {/* The title sits under its own screen. */}
              {!s.flat && <span class="wg-cap">{s.caption}</span>}
              {s.scroll && (
                /* Scrollbar of a long capture: drawn outside the frame, on its right. */
                <span data-wg-scroll aria-hidden="true" class="wg-scrollbar">
                  <i />
                </span>
              )}
            </Tag>
          );
        })}
      </div>
      <button type="button" data-spot-prev aria-label={t("workflow.galleryPrev")} class:list={[arrowBtn, "left-0 -translate-x-1/2"]} disabled={start === 0}>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="h-lg w-lg"><path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z" /></svg>
      </button>
      <button type="button" data-spot-next aria-label={t("workflow.galleryNext")} class:list={[arrowBtn, "right-0 translate-x-1/2"]} disabled={start === items.length - 1}>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="h-lg w-lg"><path d="M8.59 16.59 13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" /></svg>
      </button>
      {/* Caption, device and zoom sit under the screens, like the wireframe gallery. */}
      <div class="wg-spot-foot">
        <div class="flex items-center justify-center gap-md">
          <span aria-hidden="true" class="flex gap-sm">
            {items.map((_, i) => (
              <i data-spot-dot data-on={String(i === start)} class="block h-[calc(theme(spacing.sm)-theme(spacing.xxs))] w-[calc(theme(spacing.sm)-theme(spacing.xxs))] rounded-full bg-background-disabled data-[on=true]:w-lg data-[on=true]:bg-button-background-primary motion-safe:transition-all" />
            ))}
          </span>
          <span data-spot-count aria-live="polite" class="text-xs font-bold text-text-body-tertiary">
            {t("workflow.galleryCount", { n: String(start + 1), total: String(items.length) })}
          </span>
        </div>
      </div>
    </div>
  )
}

<style>
  /* Same screen heights as the hi-fi spotlight below (--band and the per-device --k), so a
     wireframe and its final screen are drawn at the same size. */
  .wg-rail {
    --band: calc(theme("spacing.6xl") * 4 - theme("spacing.xl") - theme("spacing.2xl") * 2);
    /* The block gap above already sets the rhythm under the heading; the mat only needs
       its 8px grid line. Below, one 24px step under the caption row. */
    padding-block: theme("spacing.lg");
  }
  .wg-mat {
    position: absolute;
    /* One cell below the mat origin, so the frames' top edge lands on a grid line while
       the mat still starts right under the label. The bottom stops before the caption row
       (the caption sits below the frames). */
    inset: theme("spacing.sm") 0 theme("spacing.2xl");
    pointer-events: none;
    --mat-minor: color-mix(in srgb, theme("colors.stroke-neutral-primary") 30%, transparent);
    --mat-major: color-mix(in srgb, theme("colors.stroke-neutral-primary") 60%, transparent);
    background-image:
      linear-gradient(var(--mat-major) calc(theme("spacing.xxs") / 2), transparent 0),
      linear-gradient(90deg, var(--mat-major) calc(theme("spacing.xxs") / 2), transparent 0),
      linear-gradient(var(--mat-minor) calc(theme("spacing.xxs") / 2), transparent 0),
      linear-gradient(90deg, var(--mat-minor) calc(theme("spacing.xxs") / 2), transparent 0);
    background-size:
      calc(theme("spacing.md") * 4) calc(theme("spacing.md") * 4),
      calc(theme("spacing.md") * 4) calc(theme("spacing.md") * 4),
      theme("spacing.md") theme("spacing.md"),
      theme("spacing.md") theme("spacing.md");
    /* Fades out on every side but is already at full strength behind the first screens. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 2%, #000 98%, transparent 100%), linear-gradient(transparent, #000 4%, #000 96%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent, #000 2%, #000 98%, transparent 100%), linear-gradient(transparent, #000 4%, #000 96%, transparent);
    mask-composite: intersect;
  }
  .wg-rail-track {
    position: relative;
    display: flex;
    align-items: center;
    /* Same gap, start offset and vertical band as the hi-fi spotlight, so both galleries lay
       their screens out identically. The captions hang under the band (absolute). */
    gap: theme("spacing.md");
    min-height: var(--band);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline-start: theme("spacing.md");
    scrollbar-width: none;
    /* The right edge fades the incoming screens without painting over the mat. */
    -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - theme("spacing.3xl")), transparent 100%);
    mask-image: linear-gradient(90deg, #000 calc(100% - theme("spacing.3xl")), transparent 100%);
    padding: 0 theme("spacing.3xl") theme("spacing.xl") theme("spacing.md");
  }
  .wg-rail-track::-webkit-scrollbar {
    display: none;
  }
  .wg-ritem {
    --k: 1;
    width: calc(var(--band) * var(--ar) * var(--k));
    max-width: 85vw;
    scroll-snap-align: start;
  }
  .wg-ritem[data-device="tablet"] {
    --k: 0.9;
  }
  .wg-ritem[data-device="phone"] {
    --k: 0.8;
  }
  @media (min-width: theme("screens.md")) {
    .wg-rail {
      --band: calc(theme("spacing.6xl") * 4 + theme("spacing.xl") - theme("spacing.2xl") * 2);
    }
    .wg-rail-track {
      gap: theme("spacing.lg");
      padding-inline-start: 0;
      scroll-padding-inline-start: 0;
    }
    /* Outside the content column: the mat runs into the gutter and past the container. */
    .wg-mat {
      inset: theme("spacing.sm") 0 theme("spacing.3xl");
      border-radius: theme("borderRadius.xl");
    }
  }

  /* Spotlight: stage with a fixed height. Every frame gets the same height (the band), so the
     widths alone show the layout at each breakpoint. 24px of dotted canvas above the screens,
     72px below for the caption + pagination band. */
  .wg-spot {
    container-type: inline-size;
    /* Vertical rhythm, top to bottom: 24 above the screens, the screens (the band), 24 down to
       the caption row, 12 to the pagination row, 16 under it. The stage height is the sum, so
       the screens keep the same size whatever the rhythm. */
    --wg-top: theme("spacing.lg");
    --wg-foot-gap: theme("spacing.sm-d");
    --wg-foot-end: theme("spacing.md");
    /* Below the screens: 24 gap + caption row 24 + gap + pagination row 16 + end. */
    --wg-ext: 0px;
    --wg-foot-pad: calc(
      theme("spacing.lg") + theme("spacing.lg") + var(--wg-foot-gap) + theme("spacing.md") + var(--wg-foot-end) + var(--wg-ext) + theme("spacing.sm")
    );
    --band: calc(theme("spacing.6xl") * 4 - theme("spacing.xl") - theme("spacing.2xl") * 2);
    --stage-h: calc(var(--band) + var(--wg-top) + var(--wg-foot-pad));
    height: var(--stage-h);
  }
  /* Caption, zoom and pagination: one column under the screens, inside the stage band the
     track already reserves (its bottom padding). */
  /* The arrows centre on the screens, not on the whole stage (caption rows included). */
  /* A long capture leaves its frame and fades out below it (24px, as in DeviceFrame): reserve
     that room so the caption row stays clear. */
  .wg-spot[data-ext] {
    --wg-ext: theme("spacing.lg");
  }
  .wg-spot > [data-spot-prev],
  .wg-spot > [data-spot-next] {
    top: calc((var(--wg-top) + var(--stage-h) - var(--wg-foot-pad)) / 2);
  }
  .wg-spot-foot {
    position: absolute;
    inset-inline: 0;
    bottom: var(--wg-foot-end);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--wg-foot-gap);
  }
  /* Hi-fi stage: the same surface as the wireframe mat (same insets, same fade), with a
     Canva-style dot field instead of the cutting grid. */
  .wg-spot-mat {
    position: absolute;
    /* 16 above and below the screens, so the dots frame them evenly and stay clear of the
       caption row. */
    inset: calc(var(--wg-top) - theme("spacing.md")) 0 calc(var(--wg-foot-pad) - theme("spacing.md"));
    pointer-events: none;
    background-image: radial-gradient(
      circle at center,
      color-mix(in srgb, theme("colors.gray.400") 62%, transparent) calc(theme("spacing.xxs") / 4),
      transparent calc(theme("spacing.xxs") * 0.75)
    );
    background-size: calc(theme("spacing.md") * 0.875) calc(theme("spacing.md") * 0.875);
    /* The dots follow the screens: --sx is the track's scrollLeft (set by the script below). */
    background-position: calc(-1 * var(--sx, 0px)) 0;
    /* Rounded, eased falloff: an ellipse that stays solid behind the screens and thins out
       gradually toward the edges (no straight band edges, no hard corners). A short linear
       fade on the left keeps the start clean. */
    --spot-fade: radial-gradient(
      ellipse 95% 100% at 50% 50%,
      #000 0%,
      #000 38%,
      rgb(0 0 0 / 0.82) 52%,
      rgb(0 0 0 / 0.55) 66%,
      rgb(0 0 0 / 0.28) 80%,
      rgb(0 0 0 / 0.09) 91%,
      transparent 100%
    );
    -webkit-mask-image: var(--spot-fade), linear-gradient(90deg, transparent, #000 6%);
    -webkit-mask-composite: source-in;
    mask-image: var(--spot-fade), linear-gradient(90deg, transparent, #000 6%);
    mask-composite: intersect;
  }
  /* Flat boards have no caption row: the dots sit right under the images. */
  .wg-spot[data-mat="grid"] {
    --wg-foot-pad: calc(var(--wg-foot-gap) + theme("spacing.sm") + theme("spacing.md") + var(--wg-foot-end));
  }
  /* Flat boards sit on the cutting mat (same grid as the wireframe rail) instead of the dots. */
  .wg-spot[data-mat="grid"] .wg-spot-mat {
    --mat-minor: color-mix(in srgb, theme("colors.stroke-neutral-primary") 30%, transparent);
    --mat-major: color-mix(in srgb, theme("colors.stroke-neutral-primary") 60%, transparent);
    background-image:
      linear-gradient(var(--mat-major) calc(theme("spacing.xxs") / 2), transparent 0),
      linear-gradient(90deg, var(--mat-major) calc(theme("spacing.xxs") / 2), transparent 0),
      linear-gradient(var(--mat-minor) calc(theme("spacing.xxs") / 2), transparent 0),
      linear-gradient(90deg, var(--mat-minor) calc(theme("spacing.xxs") / 2), transparent 0);
    background-size:
      calc(theme("spacing.md") * 4) calc(theme("spacing.md") * 4),
      calc(theme("spacing.md") * 4) calc(theme("spacing.md") * 4),
      theme("spacing.md") theme("spacing.md"),
      theme("spacing.md") theme("spacing.md");
  }
  .wg-track {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: theme("spacing.md");
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-top: var(--wg-top);
    padding-bottom: var(--wg-foot-pad);
    /* The first screen sits at the left edge; the last one can be centred. */
    --last-w: min(calc(var(--band) * var(--last-ar) * var(--last-k)), calc(100cqw - theme("spacing.2xl")));
    padding-inline-start: theme("spacing.md");
    padding-inline-end: calc((100cqw - var(--last-w)) / 2);
  }
  /* Title under its own screen: on one line below the bottom of the band (screens are centred,
     the shorter ones sit higher), under the fade of a long capture. */
  .wg-cap {
    @apply text-xs font-medium text-text-body-secondary;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    pointer-events: none;
    top: calc(100% + var(--band) * (1 - var(--k)) / 2 + var(--wg-ext) + theme("spacing.sm"));
  }
  .wg-item[data-on="true"] .wg-cap {
    @apply text-text-body-primary;
  }
  .wg-track::-webkit-scrollbar {
    display: none;
  }
  .wg-item {
    position: relative;
    /* Desktop is the reference height; tablet and phone step down a little, so the row reads
       as a hierarchy of devices rather than one wall of equal screens. The frame ratio then
       sets each width. The widest one, a 1280dp desktop window, is wider than the column on a
       tablet or a phone: cap it there so the screen is never clipped by the track edge. */
    --k: 1;
    width: calc(var(--band) * var(--ar) * var(--k));
    max-width: calc(100cqw - theme("spacing.2xl"));
    scroll-snap-align: center;
  }
  .wg-item[data-device="tablet"] {
    --k: 0.9;
  }
  .wg-item[data-device="phone"] {
    --k: 0.8;
  }
  /* Hi-fi shadow: four stacked soft layers, from a tight contact edge to a gentle ambient
     falloff. Each layer is a little larger and fainter than the last, so the shadow grows
     progressively instead of sitting as one band. Short reach (24px below the frame at most),
     neutral gray with a barely visible accent tint; the dark frames take a little more. */
  .wg-item :global(.pf) {
    --wg-tint: color-mix(in srgb, theme("colors.gray.950") 94%, theme("colors.button-background-primary"));
    --wg-a: 1;
    --wg-shadow:
      0 theme("spacing.xxs") theme("spacing.xs") 0 color-mix(in srgb, var(--wg-tint) calc(7% * var(--wg-a)), transparent),
      0 theme("spacing.xs") theme("spacing.sm") 0 color-mix(in srgb, var(--wg-tint) calc(6% * var(--wg-a)), transparent),
      0 theme("spacing.sm") theme("spacing.md") 0 color-mix(in srgb, var(--wg-tint) calc(5% * var(--wg-a)), transparent),
      0 theme("spacing.sm-d") theme("spacing.lg") 0 color-mix(in srgb, var(--wg-tint) calc(4% * var(--wg-a)), transparent);
    box-shadow: var(--wg-shadow);
  }
  .wg-item :global(.pf--dark) {
    --wg-a: 1.7;
  }
  .wg-item :global(.pf--apple) {
    box-shadow:
      0 0 0 1px var(--pf-edge),
      var(--wg-shadow);
  }
  .wg-flat {
    box-shadow: theme("boxShadow.md");
  }
  /* Discreet scrollbar outside the frame: a thin thumb, no track. */
  .wg-scrollbar {
    position: absolute;
    left: calc(100% + theme("spacing.xs"));
    top: 12%;
    bottom: 12%;
    width: theme("spacing.xs");
    pointer-events: none;
  }
  .wg-scrollbar[hidden] {
    display: none;
  }
  .wg-scrollbar i {
    position: absolute;
    left: 0;
    right: 0;
    /* Fixed length: the thumb travels faster when there is less to scroll. */
    height: calc(theme("spacing.xl") + theme("spacing.sm"));
    top: calc(var(--sb-p, 0) * (100% - theme("spacing.xl") - theme("spacing.sm")));
    border-radius: 9999px;
    /* Between gray 300 and 400: the scale has nothing in between. */
    background: color-mix(in srgb, theme("colors.gray.300") 55%, theme("colors.gray.400"));
  }
  .wg-ritem:hover .wg-flat {
    border-color: theme("colors.button-background-primary");
  }
  @media (min-width: theme("screens.md")) {
    .wg-spot {
      --band: calc(theme("spacing.6xl") * 4 + theme("spacing.xl") - theme("spacing.2xl") * 2);
    }
    .wg-spot-mat {
      inset: calc(var(--wg-top) - theme("spacing.md")) 0 calc(var(--wg-foot-pad) - theme("spacing.md")) calc(-1 * theme("spacing.lg"));
      border-radius: theme("borderRadius.xl");
    }
    /* The stage's left edge is the track's (24px past the column): the arrow sits on it. */
    .wg-spot > [data-spot-prev] {
      left: calc(-1 * theme("spacing.lg"));
    }
    .wg-track {
      gap: theme("spacing.lg");
      /* The track reaches 24px past the column on the left and pads it back, so the first
         screen stays aligned with the text while its shadow is no longer cut by the scroll box. */
      inset-inline-start: calc(-1 * theme("spacing.lg"));
      padding-inline-start: theme("spacing.lg");
      padding-inline-end: calc((100cqw + theme("spacing.lg") - var(--last-w)) / 2);
    }
  }
</style>

<script>
  // Spotlight: the screen nearest the centre is the current one (sharp, zoomable); the
  // others are dimmed and scroll to the centre when clicked. Arrows and keys step through.
  function init(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>("[data-spot-track]");
    if (!track) return;
    const items = Array.from(track.querySelectorAll<HTMLElement>(".wg-item"));
    const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-spot-dot]"));
    const prev = root.querySelector<HTMLButtonElement>("[data-spot-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-spot-next]");
    const title = root.querySelector<HTMLElement>("[data-spot-title]");
    const count = root.querySelector<HTMLElement>("[data-spot-count]");
    const template = root.dataset.countTemplate ?? "{n} / {total}";
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let current = Number(root.dataset.start ?? 0);

    const set = (i: number) => {
      if (i === current && items[i].dataset.on === "true") return;
      current = i;
      items.forEach((el, k) => (el.dataset.on = String(k === i)));
      dots.forEach((el, k) => (el.dataset.on = String(k === i)));
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === items.length - 1;
      if (title) title.textContent = items[i].dataset.caption ?? "";
      if (count) count.textContent = template.replace("{n}", String(i + 1)).replace("{total}", String(items.length));
    };

    // A screen near the start cannot always be centred (the track has nothing to scroll to), so
    // the scroll position alone cannot tell which one the arrows are on. While a move started
    // by the arrows or a click settles, the scroll handler leaves the current screen alone.
    let programmatic = false;
    let settle = 0;
    const goTo = (i: number) => {
      const index = Math.max(0, Math.min(items.length - 1, i));
      const el = items[index];
      programmatic = true;
      window.clearTimeout(settle);
      settle = window.setTimeout(() => (programmatic = false), 900);
      set(index);
      track.scrollTo({
        left: el.offsetLeft - (track.clientWidth - el.offsetWidth) / 2,
        behavior: reduce.matches ? "auto" : "smooth",
      });
    };

    // Arrive on the chosen screen, instantly (no animation).
    const first = items[current];
    track.scrollTo({ left: first.offsetLeft - (track.clientWidth - first.offsetWidth) / 2, behavior: "auto" });

    // The dotted canvas scrolls with the screens.
    const syncMat = () => root.style.setProperty("--sx", `${track.scrollLeft}px`);
    track.addEventListener("scroll", syncMat, { passive: true });
    syncMat();

    let frame = 0;
    track.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          if (programmatic) return;
          // The first screens cannot all be centred, so the current one follows the scroll
          // progress: it steps through every screen in order, from the first to the last.
          const max = track.scrollWidth - track.clientWidth;
          const t = max > 1 ? Math.min(1, Math.max(0, track.scrollLeft / max)) : 0;
          set(Math.round(t * (items.length - 1)));
        });
      },
      { passive: true },
    );

    // A dimmed neighbour comes to the centre instead of opening the modal.
    track.addEventListener(
      "click",
      (event) => {
        const el = (event.target as Element).closest<HTMLElement>(".wg-item");
        const i = el ? items.indexOf(el) : -1;
        if (i >= 0 && i !== current) {
          event.stopPropagation();
          goTo(i);
        }
      },
      true,
    );

    prev?.addEventListener("click", () => goTo(current - 1));
    next?.addEventListener("click", () => goTo(current + 1));
    root.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") goTo(current - 1);
      else if (event.key === "ArrowRight") goTo(current + 1);
      else return;
      event.preventDefault();
    });
  }

  document.querySelectorAll<HTMLElement>("[data-spot]").forEach(init);

  // Keyboard: Enter or Space opens a long capture (a div with role="button").
  document.addEventListener("keydown", (event) => {
    const el = event.target as HTMLElement | null;
    if ((event.key === "Enter" || event.key === " ") && el?.matches('div[role="button"][data-zoom]')) {
      event.preventDefault();
      el.click();
    }
  });

  // Scrollbar of the long captures: the thumb follows the screen's scroll position.
  document.querySelectorAll<HTMLElement>("[data-wg-scroll]").forEach((bar) => {
    const screen = bar.parentElement?.querySelector<HTMLElement>(".pf__screen");
    if (!screen) return;
    const sync = () => {
      const total = screen.scrollHeight;
      const visible = screen.clientHeight;
      bar.hidden = total <= visible + 1;
      if (bar.hidden) return;
      bar.style.setProperty("--sb-p", String(screen.scrollTop / (total - visible)));
    };
    screen.addEventListener("scroll", sync, { passive: true });
    screen.querySelector("img")?.addEventListener("load", sync);
    new ResizeObserver(sync).observe(screen);
    sync();
  });
</script>
