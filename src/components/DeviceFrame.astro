---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  /** phone = 9:20 (Android) or 393:852 (Apple); tablet = 10:16 or 7:10; desktop = 16:10 window. */
  device?: "phone" | "tablet" | "desktop";
  /** android = default look; apple = iPhone / iPad / macOS window. */
  platform?: "android" | "apple";
  theme?: "light" | "dark";
  /** Tablet only: 16:10 instead of portrait. */
  landscape?: boolean;
  /** Phone only: adds the browser bar of a web app (Chrome on top for Android, Safari at the bottom for Apple). */
  browser?: boolean;
  /** With `src`: a full-length capture. The screen scrolls inside the frame, the image keeps its own ratio. */
  scroll?: boolean;
  /** With `scroll`: the capture cut into files, top to bottom. The `sticky` one (the navbar) stays at the top. */
  parts?: { image: ImageMetadata; sticky?: boolean }[];
  /** Imported image (optimised by astro:assets) or a URL string. Without it, the default slot fills the screen (placeholder). */
  src?: ImageMetadata | string;
  /** Required with `src`: describe what the screenshot shows. */
  alt?: string;
  /** Any CSS width, e.g. "220px". The height follows from the device ratio. */
  width?: string;
  /** `sizes` hint for the generated srcset; default suits a frame up to 480px wide. */
  sizes?: string;
  class?: string;
}

const {
  device = "phone",
  platform = "android",
  theme = "light",
  landscape = false,
  browser = false,
  scroll = false,
  parts,
  src,
  alt,
  width,
  sizes = "(min-width: 768px) 480px, 100vw",
  class: className,
} = Astro.props;

const apple = platform === "apple";
const showUrl = device === "phone" && browser;
const classes = [
  "pf",
  apple && "pf--apple",
  device === "tablet" && "pf--tablet",
  device === "tablet" && landscape && "pf--landscape",
  device === "desktop" && "pf--desktop",
  device === "phone" && browser && "pf--browser",
  scroll && "pf--scroll",
  theme === "dark" && "pf--dark",
  className,
];
---

{/* File: src/components/DeviceFrame.astro */}
<div class:list={classes} style={width ? `width:${width}` : undefined}>
  {
    apple && device !== "desktop" && (
      <div class="pf__sb">
        <span class="pf__time" aria-hidden="true" />
        {device === "tablet" ? <b class="pf__mt" /> : <b class="pf__isl" />}
        <span class="pf__ind" aria-hidden="true">
          <i class="pf__sig" />
          <i class="pf__wifi" />
          <i class="pf__bat" />
        </span>
      </div>
    )
  }
  {
    device === "desktop" && (
      <div class="pf__chrome">
        {apple ? (
          <div class="pf__tabs">
            <span class="pf__dots" aria-hidden="true">
              <i />
              <i />
              <i />
            </span>
          </div>
        ) : (
          <>
            <div class="pf__tabs">
              <b />
            </div>
            <div class="pf__tool"><i /></div>
          </>
        )}
      </div>
    )
  }
  {showUrl && !apple && <div class="pf__url" aria-hidden="true"><i /></div>}
  <div class="pf__screen">
    {
      src === undefined ? (
        <slot />
      ) : scroll && parts && parts.length > 0 ? (
        parts.map((part, i) => (
          <Image
            src={part.image}
            alt={i === parts.length - 1 ? (alt ?? "") : ""}
            widths={[240, 480, 720, 960, 1200, 1600]}
            quality={90}
            sizes={sizes}
            format="webp"
            loading="lazy"
            decoding="async"
            class:list={[part.sticky && "pf__sticky"]}
          />
        ))
      ) : typeof src === "string" ? (
        <img src={src} alt={alt ?? ""} loading="lazy" decoding="async" />
      ) : (
        <Image src={src} alt={alt ?? ""} widths={[240, 480, 720, 960, 1200, 1600]} quality={90} sizes={sizes} format="webp" loading="lazy" decoding="async" />
      )
    }
  </div>
  {showUrl && apple && <div class="pf__url" aria-hidden="true"><i /></div>}
</div>

<style is:global>
  /* Device frame. Decorative bars and indicators are CSS shapes, never text or icons.
     Every value is read from tokens.js through theme(); the aliases below only keep the
     rules short. Ratios: see the comment above each device. */
  .pf {
    --space-xxs: theme("spacing.xxs");
    --space-xs: theme("spacing.xs");
    --space-sm: theme("spacing.sm");
    --space-sm-d: theme("spacing.sm-d");
    --space-md: theme("spacing.md");
    --space-lg: theme("spacing.lg");
    --space-xl: theme("spacing.xl");
    --radius-md: theme("borderRadius.md");
    --radius-xl: theme("borderRadius.xl");
    --radius-2xl: theme("borderRadius.2xl");
    --pf-bg: theme("colors.background-primary");
    --pf-edge: theme("colors.gray.300");
    --pf-glyph: theme("colors.gray.200");
    --pf-home: theme("colors.gray.400");
    --pf-island: theme("colors.gray.950");
    --pf-dot: theme("colors.gray.400");
    --pf-chrome: theme("colors.gray.200");
    --pf-tab: theme("colors.gray.50");
    --pf-screen: theme("colors.gray.100");
    --pf-shadow: color-mix(in srgb, theme("colors.gray.950") 22%, transparent);
    --pf-nav: var(--pf-glyph);
    position: relative;
    /* Status bar glyphs: small, and kept clear of the rounded corners (edge = 24px). */
    --pf-e: var(--space-lg);
    --pf-d: calc(var(--space-xs) * 0.75);
    --pf-i: calc(var(--space-sm) * 0.625);
    --pf-w: calc(var(--space-md) + var(--space-xs));
    /* Glyphs sit 2px below the strip centre, like the real system bar. */
    --pf-status:
      linear-gradient(var(--pf-glyph), var(--pf-glyph)) left calc(var(--pf-e) + var(--pf-d) / 2) top calc(50% + var(--space-xxs)) / var(--pf-w) var(--pf-d) no-repeat,
      radial-gradient(circle, var(--pf-glyph) 68%, transparent 72%) left var(--pf-e) top calc(50% + var(--space-xxs)) / var(--pf-d) var(--pf-d) no-repeat,
      radial-gradient(circle, var(--pf-glyph) 68%, transparent 72%) left calc(var(--pf-e) + var(--pf-w)) top calc(50% + var(--space-xxs)) / var(--pf-d) var(--pf-d) no-repeat,
      linear-gradient(var(--pf-glyph), var(--pf-glyph)) right calc(var(--pf-e) + var(--pf-i) / 2) top calc(50% + var(--space-xxs)) / var(--pf-i) var(--pf-i) no-repeat,
      radial-gradient(circle, var(--pf-glyph) 68%, transparent 72%) right var(--pf-e) top calc(50% + var(--space-xxs)) / var(--pf-i) var(--pf-i) no-repeat,
      radial-gradient(circle, var(--pf-glyph) 68%, transparent 72%) right calc(var(--pf-e) + var(--pf-i)) top calc(50% + var(--space-xxs)) / var(--pf-i) var(--pf-i) no-repeat,
      radial-gradient(circle, var(--pf-glyph) 68%, transparent 72%) right calc(var(--pf-e) + var(--pf-i) * 2.5) top calc(50% + var(--space-xxs)) / var(--pf-i) var(--pf-i) no-repeat,
      radial-gradient(circle, var(--pf-glyph) 68%, transparent 72%) right calc(var(--pf-e) + var(--pf-i) * 4.5) top calc(50% + var(--space-xxs)) / var(--pf-i) var(--pf-i) no-repeat;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    aspect-ratio: 9 / 20;
    padding: 0 var(--space-xs);
    background: var(--pf-bg);
    border: 1px solid var(--pf-edge);
    border-radius: var(--radius-xl);
    box-shadow:
      0 var(--space-md) var(--space-xl) calc(-1 * var(--space-xs)) var(--pf-shadow),
      theme("boxShadow.sm");
  }
  .pf--dark {
    --pf-bg: theme("colors.gray.900");
    --pf-edge: theme("colors.gray.700");
    --pf-glyph: theme("colors.gray.600");
    --pf-home: theme("colors.gray.500");
    --pf-dot: theme("colors.gray.600");
    --pf-chrome: theme("colors.gray.950");
    --pf-tab: theme("colors.gray.800");
    --pf-screen: theme("colors.gray.950");
    --pf-shadow: color-mix(in srgb, theme("colors.gray.950") 55%, transparent);
  }

  /* Android phone 9:20 (360 x 800 dp): status bar 3%, screen 94%, gesture bar 3% */
  .pf::before {
    content: "";
    display: block;
    flex: 3 0 0;
    min-height: 0;
    background: var(--pf-status);
  }
  .pf__screen {
    flex: 97 0 0;
    min-height: 0;
    overflow: hidden;
    background: var(--pf-screen);
  }
  .pf__screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  /* A complete screen stops short of the frame edge, with a small margin. */
  .pf:not(.pf--scroll):not(.pf--apple.pf--browser) .pf__screen {
    margin-bottom: var(--space-sm);
  }
  /* Long capture: scrolls inside the screen (native scrollbar hidden: the gallery draws a
     discreet one outside the frame). The frame itself is open at the bottom: see the
     "Long capture" block at the end of this sheet. */
  .pf--scroll .pf__screen {
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-width: none;
  }
  .pf--scroll .pf__screen::-webkit-scrollbar {
    display: none;
  }
  .pf--scroll .pf__screen img {
    height: auto;
    object-fit: initial;
  }
  /* The navbar of a long capture stays put while the page scrolls under it. */
  .pf--scroll .pf__screen img.pf__sticky {
    position: sticky;
    top: 0;
    z-index: 1;
  }
  /* Gesture bar: pill = 30% of the width (108 of 360 dp). A bar plus two dots at its ends
     draws the rounded caps. */
  /* The bar is drawn on the screen, not on the bezel: an overlay pinned to the bottom edge
     (--pf-bar tall), while the screen grows to the bottom of the frame. */
  .pf::after {
    content: "";
    display: block;
    position: absolute;
    inset: auto 0 var(--space-xxs);
    height: 3%;
    padding: 0 35%;
    background-origin: content-box;
    background-clip: content-box;
    background-repeat: no-repeat;
    background-image:
      linear-gradient(var(--pf-nav), var(--pf-nav)),
      radial-gradient(circle, var(--pf-nav) 68%, transparent 72%),
      radial-gradient(circle, var(--pf-nav) 68%, transparent 72%);
    background-position: center, left center, right center;
    background-size:
      calc(100% - var(--space-xs)) var(--space-xs),
      var(--space-xs) var(--space-xs),
      var(--space-xs) var(--space-xs);
  }

  /* Android tablet, portrait 10:16 (800 x 1280 dp): status 24, screen 1232, gesture 24 */
  .pf--tablet {
    aspect-ratio: 10 / 16;
    border-radius: var(--radius-2xl);
    padding: 0 var(--space-sm);
  }
  .pf--tablet::before {
    flex: 24 0 0;
  }
  .pf--tablet::after {
    height: 1.875%;
    padding: 0 43%;
  }
  .pf--tablet .pf__screen {
    flex-grow: 1256;
  }

  /* Desktop window 16:10. The preview never scrolls: like the other devices, the capture is
     cropped to the screen box (top edge kept) and the full image opens in the zoom modal. */
  .pf--desktop {
    aspect-ratio: 16 / 10;
    padding: var(--space-xs);
  }
  .pf--desktop::before,
  .pf--desktop::after {
    display: none;
  }
  .pf--desktop .pf__screen {
    flex-grow: 91;
    overflow: hidden;
  }
  .pf--desktop.pf--scroll .pf__screen {
    overflow-y: auto;
  }
  /* The white bezel around the window (as on a phone) already leaves a margin. */
  .pf.pf--desktop:not(.pf--scroll) .pf__screen {
    margin-bottom: 0;
  }
  /* Inner corners follow the outer radius minus the bezel (4px) and the border (1px). */
  .pf--desktop {
    --pf-inner: calc(var(--radius-xl) - var(--space-xs) - 1px);
  }
  .pf__chrome {
    flex: 9 0 0;
    min-height: 0;
    display: grid;
    grid-template-rows: 45fr 55fr;
    background: var(--pf-bg);
    border-radius: var(--pf-inner) var(--pf-inner) 0 0;
    overflow: hidden;
  }
  .pf.pf--desktop:not(.pf--scroll) .pf__screen {
    border-radius: 0 0 var(--pf-inner) var(--pf-inner);
  }
  .pf__tabs {
    display: flex;
    align-items: center;
    align-self: stretch;
    padding: 0 0 0 var(--space-sm);
  }
  .pf__tabs b {
    align-self: flex-end;
    width: 18%;
    height: 75%;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    background: var(--pf-screen);
  }
  /* macOS window dots, top left */
  .pf__dots {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }
  .pf__dots i {
    width: var(--space-sm);
    height: var(--space-sm);
    border-radius: 9999px;
    background: var(--pf-dot);
  }
  /* Address bar, as on the phone: a faintly gray pill on a white toolbar. */
  .pf__tool {
    display: flex;
    align-items: center;
    padding: 0 var(--space-sm);
  }
  .pf__tool i {
    flex: 1;
    height: 65%;
    border-radius: 9999px;
    background: var(--pf-screen);
  }

  /* Apple: thin white bezel around an edge-to-edge screen. iPhone 393 x 852 pt:
     status bar 63, screen 897, home indicator 40 (per mille). */
  .pf--apple {
    --pf-surface: theme("colors.background-primary");
    --pf-bg: var(--pf-surface);
    --pf-bezel: var(--pf-surface);
    --pf-sbi: theme("colors.gray.700");
    --pf-nav: var(--pf-home);
    aspect-ratio: 393 / 852;
    padding: 0;
    border: var(--space-xs) solid var(--pf-bezel);
    border-radius: var(--radius-2xl);
    box-shadow:
      0 0 0 1px var(--pf-edge),
      0 var(--space-md) var(--space-xl) calc(-1 * var(--space-xs)) var(--pf-shadow),
      theme("boxShadow.sm");
  }
  .pf--apple.pf--dark {
    --pf-surface: theme("colors.gray.900");
    --pf-sbi: theme("colors.gray.200");
  }
  .pf--apple::before {
    display: none;
  }
  .pf--apple::after {
    height: 4%;
    padding: 0 33%;
  }
  .pf--apple .pf__screen {
    flex-grow: 937;
  }
  .pf--apple .pf__sb {
    flex: 63 0 0;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 var(--space-sm);
  }
  .pf__time {
    justify-self: start;
    margin-left: var(--space-xs);
    width: theme("spacing.lg");
    height: var(--space-xs);
    border-radius: 9999px;
    background: var(--pf-sbi);
    opacity: 0.35;
  }
  .pf__isl {
    width: 30%;
    min-width: calc(var(--space-xl) + var(--space-md));
    height: calc(var(--space-md) + var(--space-xs));
    border-radius: 9999px;
    background: var(--pf-island);
  }
  .pf__ind {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding-right: var(--space-xs);
  }
  .pf__ind i {
    display: block;
    border-radius: 9999px;
    background: var(--pf-sbi);
    opacity: 0.35;
  }
  .pf__sig,
  .pf__wifi {
    width: var(--space-sm);
    height: var(--space-sm);
  }
  .pf__bat {
    width: var(--space-md);
    height: var(--space-sm);
  }

  /* iPad portrait 7:10 (834 x 1194 pt): multitasking dots instead of the island.
     Status 24, screen 1150, home indicator 20 (pt). */
  .pf--apple.pf--tablet {
    aspect-ratio: 7 / 10;
    border-width: calc(var(--space-xs) * 0.75);
    border-radius: var(--radius-xl);
  }
  .pf__mt {
    width: calc(var(--space-md) + var(--space-xs));
    height: var(--space-xs);
    background: radial-gradient(circle, var(--pf-sbi) 62%, transparent 66%) left center / 33.34% 100% repeat-x;
    opacity: 0.5;
  }
  .pf--apple.pf--tablet .pf__sb {
    flex: 24 0 0;
  }
  .pf--apple.pf--tablet .pf__ind {
    grid-column: 3;
  }
  .pf--apple.pf--tablet::after {
    height: 1.675%;
    padding: 0 42%;
  }
  .pf--apple.pf--tablet .pf__screen {
    flex-grow: 1170;
  }

  /* macOS window: no bezel, single title bar row, window dots on the left */
  .pf--apple.pf--desktop {
    aspect-ratio: 16 / 10;
    border: 1px solid var(--pf-edge);
    border-radius: var(--radius-xl);
    box-shadow:
      0 var(--space-md) var(--space-xl) calc(-1 * var(--space-xs)) var(--pf-shadow),
      theme("boxShadow.sm");
  }
  .pf--apple.pf--desktop .pf__chrome {
    flex-grow: 6;
    grid-template-rows: 1fr;
    background: var(--pf-tab);
  }
  .pf--apple.pf--desktop .pf__tabs {
    padding-left: var(--space-sm-d);
  }
  .pf--apple.pf--desktop .pf__tool {
    display: none;
  }
  .pf--apple.pf--desktop .pf__screen {
    flex-grow: 94;
  }

  /* Landscape tablet 16:10 */
  .pf--tablet.pf--landscape {
    aspect-ratio: 16 / 10;
  }
  .pf--tablet.pf--landscape::after {
    height: 3%;
    padding: 0 46%;
  }
  /* Android 1280 x 800 dp: status 24, screen 752, gesture 24. iPad 1194 x 834 pt: 24, 790, 20. */
  .pf--tablet.pf--landscape .pf__screen {
    flex-grow: 776;
  }
  .pf--apple.pf--tablet.pf--landscape {
    aspect-ratio: 1194 / 834;
  }
  .pf--apple.pf--tablet.pf--landscape .pf__screen {
    flex-grow: 810;
  }
  .pf--apple.pf--tablet.pf--landscape::after {
    height: 2.4%;
    padding: 0 44%;
  }

  /* Browser bar of a web app, phone only.
     Android (Chrome, address bar on top): 56 dp of 800 -> status 3, bar 7, screen 87 + 3 under the gesture bar (%).
     Apple (Safari, address bar at the bottom): 50 pt of 852 -> status 63, screen 838, bar 59 + 40 under the home
     indicator (per mille). The bar is a white toolbar with a faintly gray pill, no text. */
  .pf__url {
    flex: 7 0 0;
    min-height: 0;
    display: flex;
    align-items: center;
    padding: 0 var(--space-sm);
    background: var(--pf-bg);
  }
  .pf__url i {
    flex: 1;
    height: 70%;
    border-radius: 9999px;
    background: var(--pf-screen);
  }
  .pf--browser .pf__screen {
    flex-grow: 90;
  }
  .pf--apple.pf--browser .pf__url {
    flex-grow: 99;
    padding: 0 var(--space-md);
  }
  .pf--apple.pf--browser .pf__screen {
    flex-grow: 838;
  }

  /* Long capture: the frame is the very same device, shape and size. Only the image sticks
     out: the screen box is --pf-ext taller than its slot (negative margin), painted over the
     frame's bottom edge, and fades to nothing over that length (same px for every device).
     The gesture bar stays where it always is. */
  .pf.pf--scroll {
    --pf-ext: var(--space-lg);
    overflow: visible;
  }
  /* The image leaves the frame, so there is no bottom navigation bar on a long screen. */
  .pf.pf--scroll::after {
    display: none;
  }
  .pf.pf--scroll .pf__screen {
    margin-bottom: calc(-1 * var(--pf-ext));
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - var(--pf-ext)), transparent 100%);
    mask-image: linear-gradient(to bottom, #000 calc(100% - var(--pf-ext)), transparent 100%);
  }
</style>
