---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import WorkflowGallery from "./workflow/WorkflowGallery.astro";
import { projectImage, zoomUrl } from "../data/workflow.images";
import { useTranslations } from "../i18n/utils";

export interface Props {
  lang: "en" | "fr";
  slug: string;
  showcase: NonNullable<CollectionEntry<"projects">["data"]["showcase"]>;
}

const { lang, slug, showcase } = Astro.props;
const t = useTranslations(lang);

type Localized = string | { en: string; fr: string };
const text = (value: Localized): string => (typeof value === "string" ? value : value[lang]);

const screens = showcase.screens.map((s) => ({
  caption: text(s.caption),
  sub: s.sub ? text(s.sub) : undefined,
  alt: text(s.alt),
  src: s.src,
  device: s.device,
  platform: s.platform,
  theme: s.theme,
  browser: s.browser,
  flat: s.flat,
  scroll: s.scroll,
  parts: s.parts,
  sticky: s.sticky,
  landscape: false,
  callouts: [],
}));

const figures = (
  await Promise.all(
    showcase.figures.map(async (f) => {
      const image = projectImage(f.src);
      const zoomImage = projectImage(f.zoom) ?? image;
      if (!image || !zoomImage) return undefined;
      return { image, zoom: await zoomUrl(zoomImage, 2400), caption: text(f.caption), alt: text(f.alt) };
    }),
  )
).filter((f): f is NonNullable<typeof f> => Boolean(f));
---

{/* File: src/components/ProjectShowcase.astro */}
<div class="space-y-3xl">
  {
    screens.length > 0 && (
      <WorkflowGallery lang={lang} gallery="spotlight" screens={screens} group={`${slug}-showcase`} resolve={projectImage} />
    )
  }
  {
    figures.length > 0 && (
      <div class="grid grid-cols-1 items-center gap-x-xl gap-y-3xl md:grid-cols-2">
        {figures.map((figure) => (
          <figure class="m-0 flex flex-col items-center gap-sm">
            <button
              type="button"
              data-zoom={figure.zoom}
              data-zoom-group={`${slug}-showcase-figure`}
              aria-label={t("workflow.zoomAria", { caption: figure.caption })}
              class="block w-full max-w-[30rem] cursor-zoom-in border-0 bg-transparent p-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-body-accent"
            >
              <Image
                src={figure.image}
                alt={figure.alt}
                widths={[480, 960, 1200, 1600]}
                quality={90}
                sizes="(min-width: 768px) 336px, 100vw"
                format="webp"
                loading="lazy"
                decoding="async"
                class="block h-auto w-full drop-shadow-lg"
              />
            </button>
            <figcaption class="text-center text-xs font-medium text-text-body-secondary">{figure.caption}</figcaption>
          </figure>
        ))}
      </div>
    )
  }
</div>
