---
// src/components/WorkshopDetail.astro
// Desktop detail panel for one project: gallery (main image + 3 thumbnails) and the
// context / skills / process / team column. Images are all rendered; the page script
// shows one at a time via the hidden attribute.
import ProcessSteps from "./ProcessSteps.astro";
import type { WorkshopItem } from "../data/workshop.types";

export interface Props {
  item: WorkshopItem;
  labels: {
    context: string;
    skills: string;
    process: string;
    team: string;
    photoSoon: string;
    photoN: string;
    zoom: string;
  };
}

const { item, labels } = Astro.props;

const images = [...(item.cover ? [item.cover] : []), ...item.gallery];
// One thumbnail per image, the main image included (so it can be re-selected),
// padded to at least one row of 4.
const slotCount = Math.max(4, images.length);
const slots = Array.from({ length: slotCount }, (_, i) => ({
  url: images[i] ?? "",
  idx: i,
  label: labels.photoN.replace("{index}", String(i + 1)),
}));
---

<section
  class="grid grid-cols-12 grid-rows-[minmax(0,1fr)] gap-x-xl p-xl w-full max-h-[calc(100svh-theme(spacing.3xl)-theme(spacing.xl))] bg-background-primary border border-stroke-secondary rounded-2xl text-text-body-primary"
>
  <div class="col-span-7 min-w-0 min-h-0">
    <div class="relative w-full aspect-video min-h-64 max-h-[calc(100svh-theme(spacing.3xl)-theme(spacing.xl)-2*theme(spacing.xl)-theme(spacing.24)-theme(spacing.sm-d))] rounded-xl overflow-hidden bg-gray-100">
      {
        images.length > 0 ? (
          <button
            type="button"
            data-ws-zoom
            aria-label={labels.zoom}
            class="block w-full h-full p-0 m-0 cursor-zoom-in"
          >
            {images.map((src, i) => (
              <img
                src={src}
                alt={item.title}
                data-ws-main={i}
                loading="lazy"
                class:list={[
                  "w-full h-full",
                  item.fit === "cover" ? "object-cover" : "object-contain",
                  i !== 0 && "hidden",
                ]}
              />
            ))}
          </button>
        ) : (
          <span class="absolute inset-0 flex items-center justify-center text-sm text-text-body-tertiary">
            {labels.photoSoon}
          </span>
        )
      }
    </div>
    <div class="grid grid-flow-col auto-cols-[calc((100%-3*theme(spacing.sm-d))/4)] gap-sm-d mt-sm-d overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {
        slots.map((s) => (
          <button
            type="button"
            aria-label={s.label}
            aria-pressed={s.url && s.idx === 0 ? "true" : "false"}
            disabled={!s.url}
            data-ws-thumb={s.idx}
            class="block h-24 p-0 m-0 overflow-hidden cursor-pointer bg-gray-100 border-2 border-transparent rounded-xl disabled:cursor-default aria-pressed:border-stroke-primary-dark"
          >
            {s.url && (
              <img
                src={s.url}
                alt=""
                loading="lazy"
                class="w-full h-full object-cover block"
              />
            )}
          </button>
        ))
      }
    </div>
  </div>

  <div class="col-span-5 min-w-0 min-h-0 overflow-y-auto flex flex-col gap-lg">
    <div>
      <p class="m-0 mb-xs text-sm font-semibold text-text-body-accent">{item.line}</p>
      <h2 class="m-0 font-serif text-3xl font-semibold">{item.title}</h2>
    </div>
    <div>
      <span class="block mb-xxs text-text-body-tertiary">{labels.context}</span>
      <p class="m-0 leading-normal">{item.summary}</p>
    </div>
    <div>
      <span class="block mb-sm text-text-body-tertiary">{labels.skills}</span>
      <div class="flex flex-wrap gap-sm">
        {
          item.skillLabels.map((skill) => (
            <span class="inline-flex items-center justify-center min-h-6 px-sm-d rounded-full bg-gray-100 text-text-body-secondary text-xs font-medium text-center">
              {skill}
            </span>
          ))
        }
      </div>
    </div>
    <div>
      <span class="block mb-sm text-text-body-tertiary">{labels.process}</span>
      <ProcessSteps steps={item.steps} />
    </div>
    {
      item.team && (
        <div>
          <span class="block mb-xxs text-text-body-tertiary">{labels.team}</span>
          <p class="m-0 leading-normal">{item.team}</p>
        </div>
      )
    }
  </div>
</section>
