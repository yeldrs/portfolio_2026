---
// src/layouts/WorkshopLayout.astro
import ArrowButton from "../components/ArrowButton.astro";
import Container from "../components/Container.astro";
import FilterChips from "../components/FilterChips.astro";
import WorkshopDetail from "../components/WorkshopDetail.astro";
import WorkshopCardOpen from "../components/WorkshopCardOpen.astro";
import { workshop as workshopEn } from "../data/workshop.en";
import { workshop as workshopFr } from "../data/workshop.fr";
import { workshopMedia } from "../data/workshop.media";
import { skillLabel } from "../data/workshop.skills";
import type { WorkshopItem } from "../data/workshop.types";
import { useTranslations } from "../i18n/utils";

export interface Props {
  lang: "en" | "fr";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const data = lang === "fr" ? workshopFr : workshopEn;

const items: WorkshopItem[] = data.projects.map((p) => ({
  ...p,
  cover: workshopMedia[p.id]?.cover,
  gallery: workshopMedia[p.id]?.gallery ?? [],
  skillLabels: p.skills.map((id) => skillLabel(id, lang)),
}));

const labels = {
  context: t("project.context"),
  skills: t("workshop.skills"),
  process: t("workshop.process"),
  team: t("workshop.team"),
  photoSoon: t("workshop.photoSoon"),
  photoN: t("workshop.photoN"),
  zoom: t("workshop.zoomAria"),
};
---

<div data-ws-root>
  <Container class="py-3xl">
    <div class="text-xs tracking-wider uppercase text-text-body-tertiary">
      {data.breadcrumb}
    </div>
    <h1 class="h-display mt-sm-d md:text-5xl">{data.title}</h1>

    <div
      class="mt-lg overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      <FilterChips filters={data.filters} label={t("workshop.filtersAria")} />
    </div>

    {/* Every project stacked, full detail each. Desktop: 12-col panel; mobile: card. */}
    <div class="flex flex-col gap-lg md:gap-2xl mt-lg md:mt-xl">
      {
        items.map((item) => (
          <section
            data-ws-item
            data-tags={item.tags.join(" ")}
            data-images={JSON.stringify([...(item.cover ? [item.cover] : []), ...item.gallery])}
          >
            <div class="hidden md:block" data-ws-detail>
              <WorkshopDetail item={item} labels={labels} />
            </div>
            <div class="md:hidden">
              <WorkshopCardOpen item={item} labels={labels} />
            </div>
          </section>
        ))
      }
    </div>
  </Container>

  <div
    data-ws-modal
    hidden
    role="dialog"
    aria-modal="true"
    class="fixed inset-0 z-[9999] bg-black/80 items-center justify-center p-4 cursor-zoom-out [&:not([hidden])]:flex"
  >
    <button
      type="button"
      data-ws-modal-close
      aria-label={t("modal.close")}
      class="absolute top-4 right-4 text-white text-3xl z-10 p-2 leading-none hover:text-red-400"
    >
      &times;
    </button>
    <div class="relative flex items-center justify-center w-full h-full" data-ws-modal-body>
      <ArrowButton
        id="wsModalPrev"
        label={t("modal.previous")}
        direction="left"
        variant="tertiary"
        class="absolute left-0 z-10 transition-opacity disabled:opacity-30 disabled:pointer-events-none"
      />
      <img
        data-ws-modal-img
        alt={t("modal.enlargedImageAlt")}
        class="max-w-full max-h-full object-contain"
      />
      <ArrowButton
        id="wsModalNext"
        label={t("modal.next")}
        direction="right"
        variant="tertiary"
        class="absolute right-0 z-10 transition-opacity disabled:opacity-30 disabled:pointer-events-none"
      />
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-ws-root]");

  if (root) {
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-ws-filter]"));
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-ws-item]"));

    function setFilter(filter: string) {
      for (const el of items) {
        el.hidden = filter !== "all" && !(el.dataset.tags ?? "").split(" ").includes(filter);
      }
      for (const chip of chips) {
        chip.setAttribute("aria-pressed", String(chip.dataset.wsFilter === filter));
      }
    }

    const modal = root.querySelector<HTMLElement>("[data-ws-modal]");
    const modalImg = root.querySelector<HTMLImageElement>("[data-ws-modal-img]");
    const prevBtn = root.querySelector<HTMLButtonElement>("#wsModalPrev");
    const nextBtn = root.querySelector<HTMLButtonElement>("#wsModalNext");
    let modalList: string[] = [];
    let modalIndex = 0;
    let lastFocus: HTMLElement | null = null;

    function showModalAt(i: number) {
      if (!modalImg || i < 0 || i >= modalList.length) return;
      modalIndex = i;
      modalImg.src = modalList[i];
      const navigable = modalList.length > 1;
      for (const b of [prevBtn, nextBtn]) b?.classList.toggle("hidden", !navigable);
      if (prevBtn) prevBtn.disabled = i <= 0;
      if (nextBtn) nextBtn.disabled = i >= modalList.length - 1;
    }

    function openModal(images: string[], index: number) {
      if (!modal || images.length === 0) return;
      lastFocus = document.activeElement as HTMLElement | null;
      modalList = images;
      modal.hidden = false;
      showModalAt(index);
      modal.querySelector<HTMLElement>("[data-ws-modal-close]")?.focus();
    }

    function closeModal() {
      if (!modal || modal.hidden) return;
      modal.hidden = true;
      lastFocus?.focus();
    }

    function selectThumb(detail: HTMLElement, idx: string) {
      for (const img of detail.querySelectorAll<HTMLElement>("[data-ws-main]")) {
        img.hidden = img.dataset.wsMain !== idx;
      }
      for (const b of detail.querySelectorAll<HTMLElement>("[data-ws-thumb]")) {
        b.setAttribute("aria-pressed", String(b.dataset.wsThumb === idx));
      }
    }

    document.addEventListener("keydown", (event) => {
      if (!modal || modal.hidden) return;
      if (event.key === "Escape") closeModal();
      else if (event.key === "ArrowLeft") showModalAt(modalIndex - 1);
      else if (event.key === "ArrowRight") showModalAt(modalIndex + 1);
    });

    root.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;

      if (modal && !modal.hidden) {
        if (target.closest("#wsModalPrev")) return showModalAt(modalIndex - 1);
        if (target.closest("#wsModalNext")) return showModalAt(modalIndex + 1);
        if (target.closest("[data-ws-modal-close]") || !target.closest("[data-ws-modal-body]")) {
          return closeModal();
        }
        if (target.closest("[data-ws-modal-img]")) return;
        return closeModal();
      }

      const zoom = target.closest<HTMLElement>("[data-ws-zoom]");
      if (zoom) {
        const section = zoom.closest<HTMLElement>("[data-ws-item]");
        const images: string[] = JSON.parse(section?.dataset.images ?? "[]");
        const visible = zoom.querySelector<HTMLElement>("[data-ws-main]:not([hidden])");
        const index = zoom.dataset.wsZoom ? Number(zoom.dataset.wsZoom) : Number(visible?.dataset.wsMain ?? 0);
        return openModal(images, index);
      }

      const chip = target.closest<HTMLElement>("[data-ws-filter]");
      if (chip) return setFilter(chip.dataset.wsFilter ?? "all");

      const thumb = target.closest<HTMLButtonElement>("[data-ws-thumb]");
      if (thumb && !thumb.disabled) {
        const detail = thumb.closest<HTMLElement>("[data-ws-detail]");
        if (detail) selectThumb(detail, thumb.dataset.wsThumb ?? "0");
      }
    });
  }
</script>
