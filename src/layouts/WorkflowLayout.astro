---
import Container from "../components/Container.astro";
import ImageModal from "../components/ImageModal.astro";
import WorkflowProjectTabs from "../components/workflow/WorkflowProjectTabs.astro";
import WorkflowStep from "../components/workflow/WorkflowStep.astro";
import WorkflowStepNav from "../components/workflow/WorkflowStepNav.astro";
import WorkflowToolList from "../components/workflow/WorkflowToolList.astro";
import { getWorkflowSteps } from "../data/workflow.loader";
import { favoriteTools, toolNames } from "../data/workflow.tools";
import { workflow as workflowEn } from "../data/workflow.en";
import { workflow as workflowFr } from "../data/workflow.fr";
import { useTranslations } from "../i18n/utils";

export interface Props {
  lang: "en" | "fr";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const page = lang === "fr" ? workflowFr : workflowEn;
const steps = await getWorkflowSteps(lang);
const favorites = favoriteTools.map((id) => ({ id, name: toolNames[id] ?? id }));
---

{/* File: src/layouts/WorkflowLayout.astro */}
<div id="workflow-page">
  {/* BaseLayout gives body overflow-y:auto, which makes it a scroll container and breaks
      position:sticky. On this page the viewport scrolls instead (html keeps overflow-x hidden). */}
  <style is:global>
    html body {
      overflow: visible;
    }
    /* Gallery mats bleed past the content column on desktop. overflow-x: clip trims that
       at the viewport edge without creating a scroll container (sticky still works). */
    /* --wf-sticky: total height of the sticky stack (site navbar, mobile step menu, project
       tabs bar). --tabs-h is published by the ResizeObserver in WorkflowStepNav.astro; the
       fallbacks are the real heights so anchors stay right before that script runs. */
    #workflow-page {
      overflow-x: clip;
      --wf-sticky: calc(
        var(--site-nav-h, theme("spacing.3xl")) + var(--step-menu-h, 0px) +
          var(--tabs-h, theme("spacing.3xl"))
      );
    }
  </style>

  <Container class="pb-5xl">
    {/* Title, intro and tool list sit in the content column (same grid as the steps below),
        at the very top of the page. The step nav starts underneath, in the left column. */}
    <header class="grid grid-cols-1 gap-y-md pb-2xl pt-3xl md:grid-cols-[minmax(0,2fr)_minmax(0,7fr)] md:gap-x-3xl md:[&>*]:col-start-2">
      <p class="m-0 text-sm font-semibold text-text-body-secondary">{page.eyebrow}</p>
      <h1 class="m-0 font-serif text-4xl font-semibold italic text-balance text-text-heading-accent md:text-5xl">
        {page.title}
      </h1>
      <p class="m-0 max-w-prose text-lg leading-normal text-text-body-secondary">{page.intro}</p>
      <div class="mt-md">
        <WorkflowToolList lang={lang} tools={favorites} />
      </div>
    </header>

    <WorkflowStepNav lang={lang} steps={steps} variant="mobile" />

    <div class="mt-lg grid grid-cols-1 gap-x-3xl md:grid-cols-[minmax(0,2fr)_minmax(0,7fr)]">
      <WorkflowStepNav lang={lang} steps={steps} variant="desktop" />
      <div class="group/tabs" role="radiogroup" aria-label={t("workflow.projectAria")}>
        <WorkflowProjectTabs lang={lang} />
        <div>
          {steps.map((step) => <WorkflowStep lang={lang} step={step} intros={page.projects} />)}
        </div>
      </div>
    </div>
  </Container>
  <ImageModal />
</div>

<script>
  // Position memory. Refresh: same project, same scroll position. Switching project: the step
  // that was under the sticky stack stays there (the projects share the same steps, but their
  // heights differ, so the browser would otherwise land somewhere else).
  const KEY = `workflow-state:${location.pathname}`;
  const radios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="workflow-project"]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>("section[data-step]"));
  type State = { project: number; y: number; step: string | null; offset: number };
  const read = (): State | null => {
    try {
      return JSON.parse(sessionStorage.getItem(KEY) ?? "null");
    } catch {
      return null;
    }
  };
  const write = (s: State) => {
    try {
      sessionStorage.setItem(KEY, JSON.stringify(s));
    } catch {
      /* storage unavailable: the page still works, it just forgets */
    }
  };
  const stickyLine = () => {
    const root = document.documentElement.style;
    const px = (name: string) => parseFloat(root.getPropertyValue(name)) || 0;
    return px("--site-nav-h") + px("--step-menu-h") + px("--tabs-h");
  };
  const current = (): State => {
    const line = stickyLine() + 8;
    const hit = sections.find((s) => {
      const r = s.getBoundingClientRect();
      return r.top <= line && r.bottom > line;
    });
    return {
      project: Math.max(0, radios.findIndex((r) => r.checked)),
      y: window.scrollY,
      step: hit?.id ?? null,
      offset: hit ? hit.getBoundingClientRect().top - line : 0,
    };
  };

  let last = read() ?? current();
  let touched = false;
  const markTouched = () => (touched = true);
  ["wheel", "touchstart", "keydown", "mousedown"].forEach((e) => window.addEventListener(e, markTouched, { passive: true }));

  if ("scrollRestoration" in history) history.scrollRestoration = "manual";
  const saved = read();
  if (saved && radios[saved.project]) radios[saved.project].checked = true;
  if (saved) {
    const restore = () => {
      if (!touched) window.scrollTo(0, saved.y);
    };
    restore();
    window.addEventListener("load", restore, { once: true });
    if (document.fonts?.ready) document.fonts.ready.then(restore);
  }

  let ticking = false;
  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        last = current();
        write(last);
      });
    },
    { passive: true },
  );

  radios.forEach((radio) => {
    radio.addEventListener("change", () => {
      const anchor = last;
      const section = anchor.step ? document.getElementById(anchor.step) : null;
      if (section) {
        const line = stickyLine() + 8;
        const target = section.getBoundingClientRect().top + window.scrollY - line - anchor.offset;
        window.scrollTo(0, Math.max(0, target));
      }
      last = current();
      write(last);
    });
  });
  window.addEventListener("pagehide", () => write(current()));
</script>

<script>
  // Screenshots open in the site's preview modal; the arrows page through the screens
  // of the same block.
  document.addEventListener("click", (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>("[data-zoom]");
    if (!button) return;
    const group = button.dataset.zoomGroup;
    const list = Array.from(
      document.querySelectorAll<HTMLElement>(`[data-zoom][data-zoom-group="${group}"]`),
    ).map((el) => el.dataset.zoom as string);
    (window as unknown as { showImageModal: (url: string, list: string[]) => void }).showImageModal(
      button.dataset.zoom as string,
      list,
    );
  });
</script>
